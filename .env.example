# Required for AI Coach streaming chat
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Atlas connection (optional — falls back to memory store if unset)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=AutonoumousDB

# Resend API for student email verification OTPs (optional — logs to console if unset)
RESEND_API_KEY=re_your_resend_api_key

# JWT secret for student authentication sessions
JWT_SECRET=your_production_jwt_secret_key
